<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Workbuddy2API" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/wb_background</item>
        <item name="android:colorAccent">@color/wb_primary</item>
        <item name="android:colorControlHighlight">@color/wb_primary_container</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!-- Miuix（Compose）界面专用主题。
         为什么必须单独一个：Compose 的 ComponentActivity 需要 AppCompat/Material 系
         主题才能正确初始化窗口与主题属性；而上面那个纯 android:Theme.Material.Light
         不是 AppCompat 系，Compose 的 MaterialTheme 取色与 edge-to-edge 会走到兜底分支。
         这里继承 AppCompat 的无 ActionBar 主题并关掉系统栏对比度强制，
         让 Miuix 自己负责绘制背景。 -->
    <style name="Theme.Workbuddy2API.Miuix" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/wb_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="WbText" />

    <style name="WbText.Title">
        <item name="android:textColor">@color/wb_on_surface</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="WbText.Section">
        <item name="android:textColor">@color/wb_on_surface</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="WbText.Body">
        <item name="android:textColor">@color/wb_on_surface</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="WbText.Caption">
        <item name="android:textColor">@color/wb_on_surface_variant</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="WbButton" parent="android:style/Widget.Material.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/wb_on_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:backgroundTint">@color/wb_primary</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="WbButton.Outlined">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/wb_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:backgroundTint">@color/wb_surface</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="WbBottomNavItem">
        <item name="android:gravity">center</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:drawablePadding">3dp</item>
        <item name="android:textColor">@color/wb_on_surface_variant</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="WbStatusChip">
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
